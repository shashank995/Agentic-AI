\ls22\ilvl1
\f3\fs26 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	
\f5 \uc0\u9702 
\f3 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 after_agent
\f1\fs24 : 
\f0\b reverse order
\f1\b0  
\f6 \uc0\u8594 
\f1  MW3 
\f6 \uc0\u8594 
\f1  MW2 
