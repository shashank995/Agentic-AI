\f5 \uc0\u9702 
\f3 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 before_agent
\f1\fs24 : MW1 
\f6 \uc0\u8594 
\f1  MW2 
\f6 \uc0\u8594 
\f1  MW3 (declared order)\
\ls22\ilvl1
\f3\fs26 \kerning1\expnd0\expndtw0 \outl0\strokewidth0 {\listtext	
\f5 \uc0\u9702 
\f3 	}\expnd0\expndtw0\kerning0
\outl0\strokewidth0 \strokec2 before_model
\f1\fs24  / 
\f3\fs26 wrap_model_call
