\cf0 This is the line he drew between a function and a tool: a function that can read state, context, and stored preferences is doing something a plain function cannot.\
Concrete motivations: paid users get more capable tools than free ones; a tool that knows the user's earlier messages performs better; the "searching for X\'85" progress text you see in Claude comes from a stream writer.\
\pard\pardeftab720\sa280\partightenfactor0

\f0\b\fs28 \cf0 Demo: a loyalty store\
\pard\pardeftab720\partightenfactor0

\f2\b0\fs26 \cf0 from langgraph.store.memory import InMemoryStore\
\
loyalty_store = InMemoryStore()\
\
@tool\
def save_favorite_genre(customer_id: str, genre: str, runtime: ToolRuntime) -> str:\
    """Save a customer's favourite movie genre for future visits."""\
    runtime.store.put((customer_id, "preferences"), "favorite_genre", \{"value": genre\})\
    return f"Got it, I will remember you like \{genre\} movies"\
\
@tool\
def recall_favorite_genre(customer_id: str, runtime: ToolRuntime) -> str:\
    """Recall a customer's favourite movie genre if saved before."""\
    result = runtime.store.get((customer_id, "preferences"), "favorite_genre")\
    return result.value["value"] if result else "No saved preference for this customer"\
\
memory_agent = create_agent(\
    model=model,\
    tools=[save_favorite_genre, recall_favorite_genre],\
    store=loyalty_store,   # tools reach it via runtime\
)\
\pard\pardeftab720\sa240\partightenfactor0

