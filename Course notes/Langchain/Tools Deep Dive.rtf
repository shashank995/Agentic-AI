\f2\b0\fs26 \cf0 @tool("book_seats", description="Book cinema seats for a customer. Use whenever a customer wants to book or reserve a seat.")\
def reserve(movie: str, seats: int) -> str:\
    """Reserve seats."""\
    return f"Reserved \{seats\} seats for \{movie\}"\
\pard\pardeftab720\sa240\partightenfactor0

